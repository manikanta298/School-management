NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://frontend-javx.vercel.app
TRUST_PROXY=1
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE
JWT_SECRET=replace-with-a-secure-random-secret-of-at-least-48-characters
# Mount your database provider CA bundle in Render Secret Files as ca.pem.
# The app auto-detects /etc/secrets/ca.pem when present.
# DATABASE_CA_CERT_FILE=/etc/secrets/ca.pem
