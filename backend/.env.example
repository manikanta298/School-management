NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://school:replace-me@localhost:5432/school
JWT_SECRET=replace-with-at-least-48-random-characters-from-a-secret-generator
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_NAME=School Administrator
TRUST_PROXY=0

# Optional: database provider PEM CA bundle for verified TLS (literal \n is supported).
# DATABASE_CA_CERT=
# Optional alternative: path to a mounted provider CA certificate file.
# DATABASE_CA_CERT_FILE=/etc/secrets/ca.pem
